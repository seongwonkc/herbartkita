---
layout: base.njk
title: Young Writers Prize winners
description: Winners of the Herbart Kita Young Writers Prize.
permalink: /prize/winners/
---
{% from "macros.njk" import fill %}
{# winners.json is a list of prize cycles, newest first. Until one is added, each tier reads "to be announced". #}
<section class="page-head">
  <div class="wrap">
    <p class="kicker"><a href="/prize/">Young Writers Prize</a></p>
    <h1 class="display display--page">Winners</h1>
    <p class="lede">Results are posted here after judging.</p>
  </div>
</section>

{% if not winners.length %}
<section class="band">
  <div class="wrap">
    <h2 class="section-label">Awards</h2>
    <div class="terms">
      {% for t in programs.prize.tiers %}
      <article class="term{% if loop.first %} term--lead{% endif %}">
        <h3>{{ t.name }}</h3>
        <p><span class="tba">Winner to be announced</span></p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% for c in winners %}
<section class="band">
  <div class="wrap">
    <h2 class="section-label">{{ c.cycle }}</h2>
    <div class="terms">
      {% for t in programs.prize.tiers %}
      {% set w = c.entries[t.id] or {} %}
      <article class="term winner{% if loop.first %} term--lead{% endif %}">
        <h3>{{ t.name }}</h3>
        <dl class="biz biz--page">
          <div><dt>Name</dt><dd>{{ fill(w.name) }}</dd></div>
          <div><dt>School</dt><dd>{{ fill(w.school) }}</dd></div>
          <div><dt>Grade</dt><dd>{{ fill(w.grade) }}</dd></div>
          <div><dt>Title of work</dt><dd>{% if w.title %}<em>{{ w.title }}</em>{% else %}{{ fill("") }}{% endif %}</dd></div>
        </dl>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endfor %}
