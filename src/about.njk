---
layout: base.njk
title: About
description: Herbart Kita is an independent publisher in Gimpo, Korea, founded by Jiwon Hur and Seong Won Choi to publish writers before college.
permalink: /about/
---
{% from "macros.njk" import cover, buyLinks %}
<section class="page-head">
  <div class="wrap">
    <p class="kicker">About</p>
    <h1 class="display display--page">A small publishing house for young writers.</h1>
  </div>
</section>

<section class="band">
  <div class="wrap split">
    <h2 class="section-label">What we are</h2>
    <div class="prose">
      <p>Herbart Kita Publishing is an independent publisher in {{ site.location }}. We publish only writers who haven’t started college yet, from middle school through the gap year. So far that means {{ books.length }} books by {{ authors.length }} authors: an illustrated trilogy, a memoir, a civics guide, a book on Korean art and politics, political fables, and more.</p>
      <p>Students do more than write here. They edit, proofread, design, and publish through our <a href="/internships/">internships</a>, and they report and edit <a href="{{ site.argosyUrl }}"><em>The Argosy</em></a>, the international student newspaper we fund.</p>
    </div>
  </div>
</section>

<section class="band band--tint">
  <div class="wrap">
    <h2 class="section-label">Founders</h2>
    {% for f in founders %}
    <article class="founder">
      <header class="founder__head">
        <h3 class="founder__name">{{ f.name }}{% if f.nameKo %} <span lang="ko">{{ f.nameKo }}</span>{% endif %}</h3>
        <p class="founder__role">{{ f.role }}</p>
        <ul class="founder__edu">{% for e in f.education %}<li>{{ e }}</li>{% endfor %}</ul>
      </header>
      <div class="founder__body prose">
        {% for p in f.bio %}<p>{{ p | safe }}</p>{% endfor %}
        {% if f.books %}
        <ul class="founder__books">
          {% for b in f.books %}
          <li class="mini-book">
            {{ cover(b, "mini") }}
            <div>
              <p class="mini-book__title">{{ b.title }}</p>
              <p class="mini-book__sub">{{ b.subtitle }}</p>
              {{ buyLinks(b.links) }}
            </div>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<section class="band" id="contact">
  <div class="wrap split">
    <h2 class="section-label">Contact</h2>
    <div class="prose">
      {% if site.email %}
      <p>Manuscripts, internship applications, and everything else: <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      {% else %}
      <p>Our contact address is on its way.</p>
      {% endif %}
      {% set b = site.business %}
      {% if b.tradeName or b.representative or b.registrationNumber or b.address %}
      <h3 class="subhead" lang="ko">사업자 정보</h3>
      <dl class="biz biz--page" lang="ko">
        {% if b.tradeName %}<div><dt>상호</dt><dd>{{ b.tradeName }}</dd></div>{% endif %}
        {% if b.representative %}<div><dt>대표자</dt><dd>{{ b.representative }}</dd></div>{% endif %}
        {% if b.registrationNumber %}<div><dt>사업자등록번호</dt><dd>{{ b.registrationNumber }}</dd></div>{% endif %}
        {% if b.address %}<div><dt>주소</dt><dd>{{ b.address }}</dd></div>{% endif %}
      </dl>
      {% endif %}
    </div>
  </div>
</section>
